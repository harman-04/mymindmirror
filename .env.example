# ============================================================
# MyMindMirror — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# NEVER commit `.env` — it contains secrets.
# `.env` is already listed in `.gitignore`.
# ============================================================

# ─── Required: AI ────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key

# ─── Required: Security ──────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-64-byte-base64-secret

# Token lifetime in milliseconds (default: 24 hours)
JWT_EXPIRATION=86400000

# Generate with: openssl rand -base64 32
# MUST be exactly 32 bytes (256 bits) — the app validates this at startup.
ENCRYPTION_MASTER_KEY=your-32-byte-base64-key

# ─── Required: MySQL (primary relational store) ──────────────
DATASOURCE_URL=jdbc:mysql://localhost:3306/mymindmirror_db
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=root

# ─── Required: PostgreSQL + pgvector (vector store) ──────────
VECTOR_DB_URL=jdbc:postgresql://localhost:5432/vectordb
VECTOR_DB_USERNAME=vector
VECTOR_DB_PASSWORD=vectorpass

# ─── Optional: Redis (cache + sessions) ──────────────────────
REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_CACHE_TYPE=redis

# ─── Optional: CORS ──────────────────────────────────────────
# Comma-separated list of allowed origins. No trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ─── Optional: Server ────────────────────────────────────────
SERVER_PORT=8080
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=2048

# ─── Optional: OpenAPI / Swagger ─────────────────────────────
# Set to `false` in production.
SWAGGER_ENABLED=true

# ─── Optional: Error responses ───────────────────────────────
# When true, includes debug_message in error responses.
# NEVER enable this in production.
app.error.expose-debug=false

# ─── Optional: One-time backfill runners ─────────────────────
# Set to `true` to run on next startup. Reset to `false` after.
rag.backfill.enabled=false
backfill.enabled=false